# Required
DISCORD_TOKEN=your-bot-token

# Storage (keep on the mounted volume)
DB_PATH=/app/data/bot.db

# Optional
GUILD_ID=                 # set to your guild id for instant command sync in dev
ADMIN_ROLE=               # Discord role id — everyone with it counts as bot admin
SUPERADMIN_ROLE=          # Discord role id — everyone with it counts as bot superadmin
CUSTOMS_CATEGORY_ID=      # category where #custom-<id> + team VCs are created
CUSTOM_CONFIG_CHANNEL=    # restrict /custom create to this channel id
DEFAULT_VOICE_CHANNEL=    # players are moved here when a match ends (blank = disconnect)

# Server-local time: a bare "20:00" start time is read in this zone.
# 6 = UTC+6 (Bishkek), -5 = UTC-5. Discord gives no per-user timezone.
TZ_OFFSET=0

# Timers (seconds)
DRAFT_PICK_SECONDS=30
VETO_PICK_SECONDS=30
READY_CHECK_SECONDS=120
