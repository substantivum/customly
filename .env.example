# Required
DISCORD_TOKEN=your-bot-token

# Storage. Relative to the bot's own folder, which is what makes it portable:
# under Docker that's /app (the mounted ./data volume), on a panel host
# (bot-hosting, Pterodactyl) it's /home/container. Do NOT use /app/... outside
# Docker — that path is read-only there and the bot won't boot.
DB_PATH=data/bot.db

# Optional
GUILD_ID=                 # set to your guild id for instant command sync in dev
ADMIN_ROLE=               # Discord role id — everyone with it counts as bot admin
SUPERADMIN_ROLE=          # Discord role id — everyone with it counts as bot superadmin
CUSTOMS_CATEGORY_ID=      # category where #custom-<id> + team VCs are created
CUSTOM_CONFIG_CHANNEL=    # restrict /custom create to this channel id

# Where each staff control board may live. Set these to your private staff
# channels and `/panel tier:admin` refuses to post anywhere else (and nothing
# else may be posted in them). Leave blank to allow any channel.
ADMIN_PANEL_CHANNEL=      # channel id for the 🛡 Admin board
SUPERADMIN_PANEL_CHANNEL= # channel id for the 👑 Super Admin board

DEFAULT_VOICE_CHANNEL=    # players are moved here when a match ends (blank = disconnect)

# Server-local time: a bare "20:00" start time is read in this zone.
# 6 = UTC+6 (Bishkek), -5 = UTC-5. Discord gives no per-user timezone.
TZ_OFFSET=0

# Timers (seconds)
DRAFT_PICK_SECONDS=30
VETO_PICK_SECONDS=30
READY_CHECK_SECONDS=120

# HenrikDev Valorant API key (https://docs.henrikdev.xyz) — optional, raises
# the rate-limit tier for Riot ID verification and rank lookups in /register.
HENRIK_API_KEY=
